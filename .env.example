# ============================================================
# VARIABLES DE ENTORNO — ARGI / JOMAR (Puerto Escondido)
# Copia este archivo como .env.local y llena valores NUEVOS.
# NO reutilices el número de Meta, el proyecto de Supabase
# ni la URL de Vercel de Conchita Plata BOT.
# ============================================================

# --- App (Vercel de ESTE proyecto) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_NAME=JOMAR
NEXT_PUBLIC_ASSISTANT_NAME=ARGI
NEXT_PUBLIC_WHATSAPP_DISPLAY_NAME=Zenit pto JOMAR

# --- Supabase (proyecto NUEVO, no el de Conchita Plata) ---
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- WhatsApp Cloud API (número NUEVO de Meta) ---
# https://developers.facebook.com/apps/
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_VERIFY_TOKEN=argi_jomar_verify_token_cambiar

# --- IA (Anthropic) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# --- Upstash QStash ---
# https://console.upstash.com/qstash
QSTASH_TOKEN=eyJ...
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...
QSTASH_URL=https://qstash.upstash.io
